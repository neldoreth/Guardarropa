<UserControl x:Class="Guardarropa.Views.HistoricoZView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#1a1a2e">
        <Border Background="#16213e" CornerRadius="12" Padding="30"
                Margin="30" MaxWidth="800">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="5"/>
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" Content="Volver" Command="{Binding CerrarCommand}"
                            Background="Transparent" Foreground="#a8a8b3" BorderThickness="0"
                            Cursor="Hand" FontSize="14"/>
                    <TextBlock Text="HISTORICO DE CIERRES Z" FontSize="22" FontWeight="Bold"
                               Foreground="#e94560"/>
                </DockPanel>

                <DataGrid ItemsSource="{Binding Cierres}" AutoGenerateColumns="False"
                          IsReadOnly="True" Background="#0f3460" Foreground="White"
                          BorderBrush="#333" BorderThickness="1" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#333" RowBackground="#0f3460"
                          AlternatingRowBackground="#162447"
                          HeadersVisibility="Column" MaxHeight="400"
                          Margin="0,0,0,20">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1a1a2e"/>
                            <Setter Property="Foreground" Value="#a8a8b3"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="#333"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}" Width="*"/>
                        <DataGridTextColumn Header="Empresa" Binding="{Binding Empresa.Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Tickets" Binding="{Binding TotalTickets}" Width="80"/>
                        <DataGridTextColumn Header="Prendas" Binding="{Binding TotalPrendas}" Width="80"/>
                        <DataGridTextColumn Header="Recaudado" Binding="{Binding TotalRecaudado, StringFormat='{}{0:C2}'}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="#0f3460" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL TICKETS" Foreground="#a8a8b3" FontSize="10"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalTicketsGeneral}" Foreground="White"
                                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL PRENDAS" Foreground="#a8a8b3" FontSize="10"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalPrendasGeneral}" Foreground="White"
                                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL RECAUDADO" Foreground="#a8a8b3" FontSize="10"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalGeneral, StringFormat='{}{0:C2}'}" Foreground="#e94560"
                                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
