<UserControl x:Class="Guardarropa.Views.AjustesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource FondoPrincipal}">
        <Border Background="{DynamicResource FondoTarjeta}" CornerRadius="12" Padding="30,25"
                Margin="15" MinWidth="750" MaxWidth="950">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="5"/>
            </Border.Effect>
            <DockPanel>
                <!-- Cabecera -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" Content="Cerrar" Command="{Binding CerrarCommand}"
                            Background="Transparent" Foreground="{DynamicResource TextoSecundario}" BorderThickness="0"
                            Cursor="Hand" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="AJUSTES" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource ColorAccento}" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Boton guardar fijo abajo -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <TextBlock Text="{Binding Mensaje}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Visibility="{Binding Mensaje, Converter={StaticResource StringToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ColorExito}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HayError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ColorError}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="GUARDAR CAMBIOS" Command="{Binding GuardarConfiguracionCommand}"
                            FontSize="16" FontWeight="Bold" Padding="20,14"
                            Background="{DynamicResource ColorExito}" Foreground="White" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Pestanas -->
                <TabControl Margin="0,5,0,0" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="{DynamicResource FondoInput}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
                            <Setter Property="Padding" Value="18,10"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Bd" Background="{DynamicResource FondoInput}"
                                                CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}"
                                                Margin="0,0,3,0">
                                            <ContentPresenter x:Name="Cp" ContentSource="Header"
                                                              HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource ColorAccento}"/>
                                                <Setter TargetName="Cp" Property="TextElement.Foreground"
                                                        Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- ==================== TAB GENERAL ==================== -->
                    <TabItem Header="General">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                            <StackPanel>
                                <!-- Tema + Precio en una fila -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="APARIENCIA" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Tema oscuro" IsChecked="{Binding TemaOscuro}"
                                                         Foreground="{DynamicResource TextoPrincipal}" FontSize="14"
                                                         Margin="0,0,20,0" VerticalContentAlignment="Center"/>
                                            <RadioButton Content="Tema claro" IsChecked="{Binding TemaClaro}"
                                                         Foreground="{DynamicResource TextoPrincipal}" FontSize="14"
                                                         VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="PRECIO POR PRENDA" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding PrecioPorPrenda, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="16" Padding="8" Width="150" Background="{DynamicResource FondoInput}"
                                                     Foreground="{DynamicResource TextoPrincipal}"
                                                     BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                            <TextBlock Text="EUR" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextoSecundario}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Empresas -->
                                <TextBlock Text="EMPRESAS" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <ListBox Grid.Column="0" ItemsSource="{Binding Empresas}"
                                             SelectedItem="{Binding EmpresaSeleccionada}"
                                             DisplayMemberPath="Nombre"
                                             Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                                             BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"
                                             MaxHeight="180" Margin="0,0,12,0">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="10,5"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Nombre" Foreground="{DynamicResource TextoTerciario}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding EmpresaNombre, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="14" Padding="8" Background="{DynamicResource FondoInput}"
                                                 Foreground="{DynamicResource TextoPrincipal}"
                                                 BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Calle" Foreground="{DynamicResource TextoTerciario}" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding EmpresaCalle, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="14" Padding="8" Background="{DynamicResource FondoInput}"
                                                         Foreground="{DynamicResource TextoPrincipal}"
                                                         BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Numero" Foreground="{DynamicResource TextoTerciario}" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding EmpresaNumero, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="14" Padding="8" Background="{DynamicResource FondoInput}"
                                                         Foreground="{DynamicResource TextoPrincipal}"
                                                         BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Ciudad" Foreground="{DynamicResource TextoTerciario}" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding EmpresaCiudad, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="14" Padding="8" Background="{DynamicResource FondoInput}"
                                                         Foreground="{DynamicResource TextoPrincipal}"
                                                         BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Provincia" Foreground="{DynamicResource TextoTerciario}" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding EmpresaProvincia, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="14" Padding="8" Background="{DynamicResource FondoInput}"
                                                         Foreground="{DynamicResource TextoPrincipal}"
                                                         BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Nueva" Command="{Binding NuevaEmpresaCommand}"
                                                    Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                                                    BorderThickness="0" Cursor="Hand" Padding="16,8" FontSize="13" Margin="0,0,8,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}"
                                                                BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Content="Guardar empresa" Command="{Binding GuardarEmpresaCommand}"
                                                    Background="{DynamicResource ColorExito}" Foreground="White" BorderThickness="0"
                                                    Cursor="Hand" Padding="16,8" FontSize="13" Margin="0,0,8,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Content="Eliminar" Command="{Binding EliminarEmpresaCommand}"
                                                    Background="{DynamicResource ColorError}" Foreground="White" BorderThickness="0"
                                                    Cursor="Hand" Padding="16,8" FontSize="13">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ==================== TAB CONTRASENA ==================== -->
                    <TabItem Header="Contrasena">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                            <StackPanel>
                                <!-- Contrasena Z -->
                                <TextBlock Text="CONTRASENA Z" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding ContrasenaZ, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="20" FontWeight="Bold" Padding="12" MaxWidth="300"
                                         HorizontalAlignment="Left"
                                         Background="{DynamicResource FondoInput}" Foreground="{DynamicResource ColorAccento}"
                                         BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1" Margin="0,0,0,6"/>
                                <TextBlock Text="Necesaria para realizar el cierre Z"
                                           Foreground="{DynamicResource TextoTerciario}" FontSize="12" Margin="0,0,0,30"/>

                                <Border BorderBrush="{DynamicResource BordeCampo}" BorderThickness="0,1,0,0" Margin="0,0,0,25"/>

                                <!-- Cambiar contrasena maestra -->
                                <TextBlock Text="CAMBIAR CONTRASENA MAESTRA" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,16"/>
                                <Grid MaxWidth="700" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Contrasena actual" Foreground="{DynamicResource TextoSecundario}"
                                                   FontSize="12" Margin="0,0,0,6"/>
                                        <PasswordBox x:Name="TxtContrasenaActual" Padding="10" FontSize="14"
                                                     Background="{DynamicResource FondoInput}"
                                                     Foreground="{DynamicResource TextoPrincipal}"
                                                     BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"
                                                     PasswordChanged="TxtContrasenaActual_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="Nueva contrasena" Foreground="{DynamicResource TextoSecundario}"
                                                   FontSize="12" Margin="0,0,0,6"/>
                                        <PasswordBox x:Name="TxtNuevaContrasena" Padding="10" FontSize="14"
                                                     Background="{DynamicResource FondoInput}"
                                                     Foreground="{DynamicResource TextoPrincipal}"
                                                     BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"
                                                     PasswordChanged="TxtNuevaContrasena_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Confirmar nueva" Foreground="{DynamicResource TextoSecundario}"
                                                   FontSize="12" Margin="0,0,0,6"/>
                                        <PasswordBox x:Name="TxtConfirmarNueva" Padding="10" FontSize="14"
                                                     Background="{DynamicResource FondoInput}"
                                                     Foreground="{DynamicResource TextoPrincipal}"
                                                     BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"
                                                     PasswordChanged="TxtConfirmarNueva_Changed"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Cambiar contrasena maestra" Command="{Binding CambiarContrasenaCommand}"
                                        Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                                        BorderThickness="1" Cursor="Hand" Padding="18,10" FontSize="13"
                                        HorizontalAlignment="Left" Margin="0,16,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                    BorderBrush="{DynamicResource ColorAccento}" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ==================== TAB CIERRE Z ==================== -->
                    <TabItem Header="Cierre Z">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                            <StackPanel>
                                <!-- Contador total de tickets -->
                                <TextBlock Text="CONTADOR TOTAL DE TICKETS" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,8"/>
                                <TextBlock Foreground="{DynamicResource TextoTerciario}" FontSize="12" Margin="0,0,0,16"
                                           TextWrapping="Wrap">
                                    Numero acumulado de tickets emitidos en toda la historia de la aplicacion.
                                    No se reinicia con el cierre Z, solo manualmente.
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                                    <Border Background="{DynamicResource FondoInput}" CornerRadius="6"
                                            Padding="20,12" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Tickets emitidos: " FontSize="16"
                                                       Foreground="{DynamicResource TextoSecundario}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ContadorTickets}" FontSize="28" FontWeight="Bold"
                                                       Foreground="{DynamicResource ColorAccento}"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Reiniciar contador" Command="{Binding ReiniciarContadorTicketsCommand}"
                                            Background="{DynamicResource ColorError}" Foreground="White" BorderThickness="0"
                                            Cursor="Hand" Padding="18,12" FontSize="13" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <Border BorderBrush="{DynamicResource BordeCampo}" BorderThickness="0,1,0,0" Margin="0,0,0,25"/>

                                <!-- Historico -->
                                <TextBlock Text="HISTORICO DE CIERRES Z" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,8"/>
                                <TextBlock Foreground="{DynamicResource TextoTerciario}" FontSize="12" Margin="0,0,0,16">
                                    Consulta todos los cierres realizados con fecha, perchas emitidas y recaudacion.
                                </TextBlock>
                                <Button Content="Ver historico de cierres Z" Command="{Binding AbrirHistoricoCommand}"
                                        Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                                        BorderThickness="0" Cursor="Hand" Padding="20,14" FontSize="15"
                                        HorizontalAlignment="Left">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                    BorderBrush="{DynamicResource ColorExito}" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ==================== TAB IMPRESORA ==================== -->
                    <TabItem Header="Impresora">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="IMPRESORA" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding ImpresorasDisponibles}"
                                          SelectedItem="{Binding NombreImpresora}"
                                          FontSize="14" Padding="10" Background="{DynamicResource FondoInput}"
                                          Foreground="{DynamicResource TextoPrincipal}"
                                          BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1" Margin="0,0,0,25"/>

                                <TextBlock Text="DIMENSIONES DEL TICKET" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,25">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Ancho (mm)" Foreground="{DynamicResource TextoSecundario}" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding AnchoTicketMm}" Padding="10" FontSize="16"
                                                 Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                                                 BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Alto (mm)" Foreground="{DynamicResource TextoSecundario}" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding AltoTicketMm}" Padding="10" FontSize="16"
                                                 Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                                                 BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="MARGENES (mm)" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,25">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Izquierdo" Foreground="{DynamicResource TextoTerciario}" FontSize="11" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding MargenIzquierdoMm}" Padding="10" FontSize="14"
                                                 Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                                                 BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Text="Derecho" Foreground="{DynamicResource TextoTerciario}" FontSize="11" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding MargenDerechoMm}" Padding="10" FontSize="14"
                                                 Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                                                 BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                        <TextBlock Text="Superior" Foreground="{DynamicResource TextoTerciario}" FontSize="11" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding MargenSuperiorMm}" Padding="10" FontSize="14"
                                                 Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                                                 BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                        <TextBlock Text="Inferior" Foreground="{DynamicResource TextoTerciario}" FontSize="11" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding MargenInferiorMm}" Padding="10" FontSize="14"
                                                 Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                                                 BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="TAMANO DE TEXTOS (pt)" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Normal" Foreground="{DynamicResource TextoTerciario}" FontSize="11" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding TamanoTextoNormal}" Padding="10" FontSize="14"
                                                 Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                                                 BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Text="Titulo" Foreground="{DynamicResource TextoTerciario}" FontSize="11" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding TamanoTextoTitulo}" Padding="10" FontSize="14"
                                                 Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                                                 BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="Grande (n ticket)" Foreground="{DynamicResource TextoTerciario}" FontSize="11" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding TamanoTextoGrande}" Padding="10" FontSize="14"
                                                 Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                                                 BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
