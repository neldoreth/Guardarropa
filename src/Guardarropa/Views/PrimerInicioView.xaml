<UserControl x:Class="Guardarropa.Views.PrimerInicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource FondoPrincipal}">
        <Border Background="{DynamicResource FondoTarjeta}" CornerRadius="12" Padding="40"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="400" MaxWidth="500">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="GUARDARROPA" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource ColorAccento}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding Titulo}" FontSize="14"
                           Foreground="{DynamicResource TextoSecundario}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="{Binding Subtitulo}" FontSize="13"
                           Foreground="{DynamicResource TextoPrincipal}" TextWrapping="Wrap" Margin="0,0,0,15"/>

                <TextBlock Text="Contrasena:" Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtContrasena" FontSize="16" Padding="10"
                             Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                             BorderBrush="{DynamicResource ColorAccento}" BorderThickness="1" Margin="0,0,0,15"
                             PasswordChanged="TxtContrasena_PasswordChanged"/>

                <TextBlock Text="Confirmar contrasena:" Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtConfirmar" FontSize="16" Padding="10"
                             Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                             BorderBrush="{DynamicResource ColorAccento}" BorderThickness="1" Margin="0,0,0,20"
                             PasswordChanged="TxtConfirmar_PasswordChanged"/>

                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ColorError}" FontSize="12"
                           Margin="0,0,0,15" TextWrapping="Wrap"
                           Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}"/>

                <Button Content="{Binding TextoBoton}" Command="{Binding GuardarCommand}"
                        FontSize="16" FontWeight="Bold" Padding="15,12"
                        Background="{DynamicResource ColorAccento}" Foreground="White" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
