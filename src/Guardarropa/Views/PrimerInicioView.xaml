<UserControl x:Class="Guardarropa.Views.PrimerInicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#1a1a2e">
        <Border Background="#16213e" CornerRadius="12" Padding="40"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="400" MaxWidth="500">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="GUARDARROPA" FontSize="28" FontWeight="Bold"
                           Foreground="#e94560" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Configuracion inicial" FontSize="14"
                           Foreground="#a8a8b3" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Establece tu contrasena maestra" FontSize="13"
                           Foreground="White" Margin="0,0,0,15"/>

                <TextBlock Text="Contrasena:" Foreground="#a8a8b3" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtContrasena" FontSize="16" Padding="10"
                             Background="#0f3460" Foreground="White" BorderBrush="#e94560"
                             BorderThickness="1" Margin="0,0,0,15"
                             PasswordChanged="TxtContrasena_PasswordChanged"/>

                <TextBlock Text="Confirmar contrasena:" Foreground="#a8a8b3" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtConfirmar" FontSize="16" Padding="10"
                             Background="#0f3460" Foreground="White" BorderBrush="#e94560"
                             BorderThickness="1" Margin="0,0,0,20"
                             PasswordChanged="TxtConfirmar_PasswordChanged"/>

                <TextBlock Text="{Binding Error}" Foreground="#ff6b6b" FontSize="12"
                           Margin="0,0,0,15" TextWrapping="Wrap"
                           Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}"/>

                <Button Content="CREAR CONTRASENA" Command="{Binding GuardarCommand}"
                        FontSize="16" FontWeight="Bold" Padding="15,12"
                        Background="#e94560" Foreground="White" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
