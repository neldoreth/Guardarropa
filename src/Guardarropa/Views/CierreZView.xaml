<UserControl x:Class="Guardarropa.Views.CierreZView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#1a1a2e">
        <Border Background="#16213e" CornerRadius="12" Padding="40"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="420" MaxWidth="500">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="CIERRE Z" FontSize="24" FontWeight="Bold"
                           Foreground="#e94560" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Antes del cierre -->
                <StackPanel Visibility="{Binding CierreRealizado, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="Introduce la contrasena Z para realizar el cierre:"
                               Foreground="White" FontSize="13" Margin="0,0,0,10"/>
                    <PasswordBox x:Name="TxtContrasenaZ" FontSize="16" Padding="10"
                                 Background="#0f3460" Foreground="White"
                                 BorderBrush="#e94560" BorderThickness="1" Margin="0,0,0,20"
                                 PasswordChanged="TxtContrasenaZ_Changed"/>

                    <Button Content="REALIZAR CIERRE Z" Command="{Binding RealizarCierreCommand}"
                            FontSize="16" FontWeight="Bold" Padding="15,12"
                            Background="#e94560" Foreground="White" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Despues del cierre -->
                <StackPanel Visibility="{Binding CierreRealizado, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="#0f3460" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="RESUMEN DEL CIERRE" FontSize="14" FontWeight="Bold"
                                       Foreground="#4ecca3" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total tickets:" Foreground="#a8a8b3" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalTickets}"
                                           Foreground="White" FontSize="14" FontWeight="Bold"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total prendas:" Foreground="#a8a8b3" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalPrendas}"
                                           Foreground="White" FontSize="14" FontWeight="Bold"/>
                            </Grid>

                            <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="0,5,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOTAL RECAUDADO:" Foreground="White"
                                           FontSize="16" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TotalRecaudado, StringFormat='{}{0:C2}'}"
                                           Foreground="#e94560" FontSize="20" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="IMPRIMIR CIERRE" Command="{Binding ImprimirCierreCommand}"
                            FontSize="14" FontWeight="Bold" Padding="15,10"
                            Background="#4ecca3" Foreground="White" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding Mensaje}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding Mensaje, Converter={StaticResource StringToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#4ecca3"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HayError}" Value="True">
                                    <Setter Property="Foreground" Value="#ff6b6b"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Content="Volver" Command="{Binding CerrarCommand}"
                        Background="Transparent" Foreground="#a8a8b3" BorderThickness="0"
                        Cursor="Hand" FontSize="12" Margin="0,15,0,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
