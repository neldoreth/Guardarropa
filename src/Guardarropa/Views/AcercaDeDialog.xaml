<Window x:Class="Guardarropa.Views.AcercaDeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de" Width="440" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="/Assets/icono.ico"
        Background="{DynamicResource FondoTarjeta}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="TxtNombre" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource ColorAccento}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtVersion" FontSize="13"
                       Foreground="{DynamicResource TextoSecundario}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock x:Name="TxtDesarrollador" FontSize="12"
                       Foreground="{DynamicResource TextoSecundario}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource FondoInput}" CornerRadius="8" Padding="18,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelHistorial"/>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2" Content="Cerrar" Click="Cerrar_Click"
                Background="{DynamicResource ColorAccento}" Foreground="White" BorderThickness="0"
                Cursor="Hand" Padding="15,8" FontSize="13"
                HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
