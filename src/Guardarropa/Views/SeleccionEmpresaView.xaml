<UserControl x:Class="Guardarropa.Views.SeleccionEmpresaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#1a1a2e">
        <Border Background="#16213e" CornerRadius="12" Padding="40"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="400" MaxWidth="500">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="GUARDARROPA" FontSize="28" FontWeight="Bold"
                           Foreground="#e94560" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Selecciona una empresa" FontSize="14"
                           Foreground="#a8a8b3" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <ListBox ItemsSource="{Binding Empresas}"
                         SelectedItem="{Binding EmpresaSeleccionada}"
                         DisplayMemberPath="Nombre"
                         Background="#0f3460" Foreground="White"
                         BorderBrush="#e94560" BorderThickness="1"
                         FontSize="16" MinHeight="150" MaxHeight="300"
                         Margin="0,0,0,15" Padding="5">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock Text="{Binding Error}" Foreground="#ff6b6b" FontSize="12"
                           Margin="0,0,0,10" TextWrapping="Wrap"
                           Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}"/>

                <Button Content="CONTINUAR" Command="{Binding ContinuarCommand}"
                        FontSize="16" FontWeight="Bold" Padding="15,12"
                        Background="#e94560" Foreground="White" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Ajustes" Command="{Binding AbrirAjustesCommand}"
                        FontSize="12" Padding="8,6"
                        Background="Transparent" Foreground="#a8a8b3" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="#a8a8b3" TextDecorations="Underline"
                                       HorizontalAlignment="Center"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
