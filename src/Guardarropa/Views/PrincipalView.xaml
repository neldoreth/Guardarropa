<UserControl x:Class="Guardarropa.Views.PrincipalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Background="{DynamicResource FondoPrincipal}" PreviewKeyDown="Grid_PreviewKeyDown"
          MouseDown="Grid_MouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource FondoBarraSuperior}" Padding="15,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Cambiar empresa" Command="{Binding VolverSeleccionCommand}"
                            Background="Transparent" Foreground="{DynamicResource TextoSecundario}" BorderThickness="0"
                            Cursor="Hand" FontSize="12" Margin="0,0,15,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cierre Z" Command="{Binding AbrirCierreZCommand}"
                            Background="{DynamicResource ColorAccento}" Foreground="White" BorderThickness="0"
                            Cursor="Hand" FontSize="12" Padding="12,6" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Ajustes" Command="{Binding AbrirAjustesCommand}"
                            Background="Transparent" Foreground="{DynamicResource TextoSecundario}" BorderThickness="0"
                            Cursor="Hand" FontSize="12"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NombreEmpresa}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextoPrincipal}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding FechaActual}" FontSize="11"
                               Foreground="{DynamicResource TextoSecundario}" HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="{DynamicResource FondoTarjeta}" CornerRadius="12" Padding="50"
                    MinWidth="480">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Numero de percha editable -->
                    <TextBlock Text="Percha n:" FontSize="12"
                               Foreground="{DynamicResource TextoSecundario}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNumeroPercha"
                             Text="{Binding NumeroPercha, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="32" FontWeight="Bold"
                             Background="{DynamicResource FondoInput}"
                             Foreground="{DynamicResource ColorAccento}"
                             BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             Padding="10,6" Width="140"
                             HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBlock Text="Numero de prendas:" Foreground="{DynamicResource TextoPrincipal}"
                               FontSize="14" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="-" FontSize="24" FontWeight="Bold"
                                Width="50" Height="50"
                                Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}" BorderThickness="0"
                                Cursor="Hand" Click="BtnMenos_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBox Grid.Column="1" Text="{Binding NumeroPrendas, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="36" FontWeight="Bold"
                                 Background="Transparent" Foreground="{DynamicResource TextoPrincipal}"
                                 BorderThickness="0" HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center" Margin="15,0"/>

                        <Button Grid.Column="2" Content="+" FontSize="24" FontWeight="Bold"
                                Width="50" Height="50"
                                Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}" BorderThickness="0"
                                Cursor="Hand" Click="BtnMas_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Border Background="{DynamicResource FondoPrecio}" CornerRadius="8" Padding="20" Margin="0,0,0,25">
                        <StackPanel>
                            <TextBlock Text="TOTAL A PAGAR" FontSize="12" Foreground="{DynamicResource TextoSecundario}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding PrecioTotal, StringFormat='{}{0:C2}'}"
                                       FontSize="42" FontWeight="Bold" Foreground="{DynamicResource ColorAccento}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding PrecioPorPrenda, StringFormat='({0:C2} por prenda)'}"
                                       FontSize="11" Foreground="{DynamicResource TextoSecundario}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="IMPRIMIR PERCHA" Command="{Binding ImprimirTicketCommand}"
                            FontSize="22" FontWeight="Bold" Padding="20,18"
                            Background="{DynamicResource ColorAccento}" Foreground="White" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="{Binding Mensaje}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,15,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding Mensaje, Converter={StaticResource StringToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ColorExito}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HayError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ColorError}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
