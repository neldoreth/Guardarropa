<Window x:Class="Guardarropa.Views.ContrasenaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contrasena requerida" Width="380" Height="220"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#16213e">
    <Grid Margin="30,20">
        <StackPanel>
            <TextBlock Text="Introduce la contrasena maestra:" Foreground="White"
                       FontSize="14" Margin="0,0,0,15"/>
            <PasswordBox x:Name="TxtContrasena" FontSize="16" Padding="10"
                         Background="#0f3460" Foreground="White"
                         BorderBrush="#e94560" BorderThickness="1" Margin="0,0,0,8"/>
            <TextBlock x:Name="TxtError" Text="" Foreground="#ff6b6b" FontSize="12"
                       Margin="0,0,0,15"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="Cancelar_Click"
                        Background="Transparent" Foreground="#a8a8b3" BorderThickness="0"
                        Cursor="Hand" Padding="15,8" FontSize="13" Margin="0,0,10,0"/>
                <Button Content="Aceptar" Click="Aceptar_Click"
                        Background="#e94560" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Padding="15,8" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
