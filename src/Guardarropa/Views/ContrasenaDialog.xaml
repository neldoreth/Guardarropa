<Window x:Class="Guardarropa.Views.ContrasenaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contrasena requerida" Width="390" Height="245"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource FondoTarjeta}">
    <Grid Margin="30,20">
        <StackPanel>
            <TextBlock Text="Introduce la contrasena maestra:" Foreground="{DynamicResource TextoPrincipal}"
                       FontSize="14" Margin="0,0,0,15"/>
            <PasswordBox x:Name="TxtContrasena" FontSize="16" Padding="10"
                         Background="{DynamicResource FondoInput}" Foreground="{DynamicResource TextoPrincipal}"
                         BorderBrush="{DynamicResource ColorAccento}" BorderThickness="1" Margin="0,0,0,8"/>
            <TextBlock x:Name="TxtError" Text="" Foreground="{DynamicResource ColorError}" FontSize="12"
                       Margin="0,0,0,15"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="Cancelar_Click"
                        Background="Transparent" Foreground="{DynamicResource TextoSecundario}" BorderThickness="0"
                        Cursor="Hand" Padding="15,8" FontSize="13" Margin="0,0,10,0"/>
                <Button Content="Aceptar" Click="Aceptar_Click"
                        Background="{DynamicResource ColorAccento}" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Padding="15,8" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
